# LLM provider: "groq" (default) or "mistral"
LLM_PROVIDER=groq
# Optional model override (default: openai/gpt-oss-120b / mistral-small-latest)
LLM_MODEL=
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Only needed if LLM_PROVIDER=mistral: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Local (non-Docker) service locations. docker-compose overrides these.
QDRANT_HOST=localhost
QDRANT_PORT=6333
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=legal_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
REDIS_HOST=localhost
REDIS_PORT=6379
BACKEND_URL=http://localhost:8001
